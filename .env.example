# FOCUSFLOW Root Environment Variables
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/focusflow?schema=public"

# Frontend Web Origin & Optional API Base Override (leave empty for same-origin /api/v1)
WEB_ORIGIN="http://localhost:3000"
VITE_API_BASE_URL=""

# JWT Authentication Secrets
JWT_ACCESS_SECRET="focusflow-access-secret-placeholder-min-32-chars"
JWT_REFRESH_SECRET="focusflow-refresh-secret-placeholder-min-32-chars"

# AI Productivity Coach Provider (Server-Side Only)
AI_PROVIDER="gemini"
AI_API_KEY="your_gemini_or_openai_api_key_here"

# Google AI Studio Hosting Reference
APP_URL="http://localhost:3000"
